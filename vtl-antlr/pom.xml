<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.insee.trevas</groupId>
        <artifactId>trevas-parent</artifactId>
        <version>2.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>vtl-antlr</artifactId>
    <name>VTL ANTLR Runtime (relocated)</name>
    <description>
        Source-level relocation of antlr4-runtime into the fr.insee.vtl.antlr.* namespace so it
        does not collide with the ANTLR runtime that Apache Spark bundles. The relocated sources
        are committed under src/main/java so the IDE sees this module as a plain Java project.
        To re-vendor after bumping antlr4.version, run:
            ./mvnw -pl vtl-antlr -Pvendor-antlr generate-sources
        and commit the diff under src/main/java/fr/.
    </description>
    <version>2.5.0-SNAPSHOT</version>

    <!--    Warning: not latest, align with version embedded by Spark-->
    <properties>
        <antlr4.version>4.9.3</antlr4.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <!-- The vendored ANTLR runtime is third-party source; preserve its original
                     formatting and BSD-3-Clause headers verbatim. -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <excludes>
                            <exclude>src/main/java/fr/insee/vtl/antlr/**/*.java</exclude>
                        </excludes>
                        <googleJavaFormat>
                            <version>1.27.0</version>
                        </googleJavaFormat>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Re-vendor the relocated ANTLR runtime into src/main/java.
                 Run on demand: ./mvnw -pl vtl-antlr -Pvendor-antlr generate-sources -->
            <id>vendor-antlr</id>
            <build>
                <plugins>
                    <plugin>
                        <!-- 1) Unpack antlr4-runtime sources into a staging directory under target/. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>unpack-antlr-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>org.antlr</groupId>
                                            <artifactId>antlr4-runtime</artifactId>
                                            <version>${antlr4.version}</version>
                                            <classifier>sources</classifier>
                                            <outputDirectory>${project.build.directory}/antlr-staging</outputDirectory>
                                            <includes>org/antlr/v4/**/*.java</includes>
                                            <overWrite>true</overWrite>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- 2) Rewrite `org.antlr.v4` -> `fr.insee.vtl.antlr` in the staged sources,
                             wipe the prior vendored tree, and move the relocated package directory
                             into the canonical src/main/java location. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>relocate-and-vendor-antlr-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <replaceregexp match="org\.antlr\.v4" replace="fr.insee.vtl.antlr" flags="g">
                                            <fileset dir="${project.build.directory}/antlr-staging" includes="**/*.java"/>
                                        </replaceregexp>
                                        <delete dir="${project.basedir}/src/main/java/fr/insee/vtl/antlr"/>
                                        <move todir="${project.basedir}/src/main/java/fr/insee/vtl/antlr">
                                            <fileset dir="${project.build.directory}/antlr-staging/org/antlr/v4"/>
                                        </move>
                                        <delete dir="${project.build.directory}/antlr-staging"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
