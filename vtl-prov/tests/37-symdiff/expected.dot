digraph {
  // §5.10/37 — symdiff: both operands are value inputs (like intersect).

  "ds1@0"    [kind=dataset];
  "ds1@0.id" [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=STRING];
  "ds1@0.m1" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];

  "ds2@0"    [kind=dataset];
  "ds2@0.id" [kind=variable, dataset="ds2@0", role=IDENTIFIER, type=STRING];
  "ds2@0.m1" [kind=variable, dataset="ds2@0", role=MEASURE, type=INTEGER];

  "ds_s@1"    [kind=dataset, src="symdiff(ds1, ds2)"];
  "ds_s@1.id" [kind=variable, dataset="ds_s@1", role=IDENTIFIER, type=STRING];
  "ds_s@1.m1" [kind=variable, dataset="ds_s@1", role=MEASURE, type=INTEGER];

  "ds_s@1"    -> "ds1@0"    [op=symdiff];
  "ds_s@1"    -> "ds2@0"    [op=symdiff];
  "ds_s@1.id" -> "ds1@0.id" [op=symdiff];
  "ds_s@1.id" -> "ds2@0.id" [op=symdiff];
  "ds_s@1.m1" -> "ds1@0.m1" [op=symdiff];
  "ds_s@1.m1" -> "ds2@0.m1" [op=symdiff];
}
