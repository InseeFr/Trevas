/* $input ds1
 * | id         | q          | val     |
 * | STRING     | STRING     | INTEGER |
 * | IDENTIFIER | IDENTIFIER | MEASURE |
 * |------------|------------|---------|
 * | A          | Q1         | 10      |
 * | A          | Q2         | 20      |
 */
ds2 := ds1[customPivot q, val in "Q1", "Q2"];
