digraph {
  // input binding: ds1
  "ds1@0"    [kind=dataset];
  "ds1@0.id" [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=STRING];
  "ds1@0.m1" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];

  // input binding: ds2 (same structure)
  "ds2@0"    [kind=dataset];
  "ds2@0.id" [kind=variable, dataset="ds2@0", role=IDENTIFIER, type=STRING];
  "ds2@0.m1" [kind=variable, dataset="ds2@0", role=MEASURE, type=INTEGER];

  // stmt 1: ds_d := setdiff(ds1, ds2)
  // values come only from ds1; ds2 is a condition (decides exclusion)
  "ds_d@1"    [kind=dataset, src="setdiff(ds1, ds2)"];
  "ds_d@1.id" [kind=variable, dataset="ds_d@1", role=IDENTIFIER, type=STRING];
  "ds_d@1.m1" [kind=variable, dataset="ds_d@1", role=MEASURE, type=INTEGER];

  "ds_d@1"    -> "ds1@0"    [op=setdiff];
  "ds_d@1"    -> "ds2@0"    [op=setdiff, role=condition];
  "ds_d@1.id" -> "ds1@0.id" [op=setdiff];
  "ds_d@1.m1" -> "ds1@0.m1" [op=setdiff];
}
