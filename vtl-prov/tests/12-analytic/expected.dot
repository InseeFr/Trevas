digraph {
  // input binding: ds1
  "ds1@0"    [kind=dataset];
  "ds1@0.id" [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=STRING];
  "ds1@0.t"  [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=INTEGER];
  "ds1@0.m1" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];

  // stmt 1: ds2 := ds1[calc running := sum(m1) over (partition by id order by t)]
  "ds2@1"         [kind=dataset, src="ds1[calc running := sum(m1) over (partition by id order by t)]"];
  "ds2@1.id"      [kind=variable, dataset="ds2@1", role=IDENTIFIER, type=STRING];
  "ds2@1.t"       [kind=variable, dataset="ds2@1", role=IDENTIFIER, type=INTEGER];
  "ds2@1.m1"      [kind=variable, dataset="ds2@1", role=MEASURE, type=INTEGER];
  "ds2@1.running" [kind=variable, dataset="ds2@1", role=MEASURE, type=INTEGER];

  // analytic expression: value dep on m1; partition/order keys are conditions
  "e1.1"  [kind=expression, src="sum(m1) over (partition by id order by t)"];
  "e1.1" -> "ds1@0.m1";
  "e1.1" -> "ds1@0.id" [role=condition];
  "e1.1" -> "ds1@0.t"  [role=condition];

  // running from its defining expression; other columns pass through
  "ds2@1"         -> "ds1@0"    [op=calc];
  "ds2@1.running" -> "e1.1"     [op=calc];
  "ds2@1.id"      -> "ds1@0.id" [op=calc];
  "ds2@1.t"       -> "ds1@0.t"  [op=calc];
  "ds2@1.m1"      -> "ds1@0.m1" [op=calc];
}
