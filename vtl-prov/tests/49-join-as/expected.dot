digraph {
  // Wave G PR-48 — join AS aliases (empty body). Same lineage as 08-join.

  "ds1@0"    [kind=dataset];
  "ds1@0.id" [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=STRING];
  "ds1@0.m1" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];

  "ds2@0"    [kind=dataset];
  "ds2@0.id" [kind=variable, dataset="ds2@0", role=IDENTIFIER, type=STRING];
  "ds2@0.m2" [kind=variable, dataset="ds2@0", role=MEASURE, type=INTEGER];

  "ds_j@1"    [kind=dataset, src="inner_join(ds1 as d1, ds2 as d2 using id)"];
  "ds_j@1.id" [kind=variable, dataset="ds_j@1", role=IDENTIFIER, type=STRING];
  "ds_j@1.m1" [kind=variable, dataset="ds_j@1", role=MEASURE, type=INTEGER];
  "ds_j@1.m2" [kind=variable, dataset="ds_j@1", role=MEASURE, type=INTEGER];

  "ds_j@1"    -> "ds1@0"    [op=inner_join];
  "ds_j@1"    -> "ds2@0"    [op=inner_join];
  "ds_j@1.id" -> "ds1@0.id" [op=inner_join];
  "ds_j@1.id" -> "ds2@0.id" [op=inner_join];
  "ds_j@1.m1" -> "ds1@0.m1" [op=inner_join];
  "ds_j@1.m2" -> "ds2@0.m2" [op=inner_join];
}
