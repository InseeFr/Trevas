# --- input binding: ds1
ds1@0            a          dataset
ds1@0.id         a          variable
ds1@0.id         dataset    ds1@0
ds1@0.id         role       IDENTIFIER
ds1@0.id         type       STRING
ds1@0.var1       a          variable
ds1@0.var1       dataset    ds1@0
ds1@0.var1       role       MEASURE
ds1@0.var1       type       INTEGER
ds1@0.var2       a          variable
ds1@0.var2       dataset    ds1@0
ds1@0.var2       role       MEASURE
ds1@0.var2       type       INTEGER

# --- stmt 1: ds2 := ds1[calc var_sum := var1 + var2]
ds2@1            a          dataset
ds2@1            src        "ds1[calc var_sum := var1 + var2]"
ds2@1.id         a          variable
ds2@1.id         dataset    ds2@1
ds2@1.id         role       IDENTIFIER
ds2@1.id         type       STRING
ds2@1.var1       a          variable
ds2@1.var1       dataset    ds2@1
ds2@1.var1       role       MEASURE
ds2@1.var1       type       INTEGER
ds2@1.var2       a          variable
ds2@1.var2       dataset    ds2@1
ds2@1.var2       role       MEASURE
ds2@1.var2       type       INTEGER
ds2@1.var_sum    a          variable
ds2@1.var_sum    dataset    ds2@1
ds2@1.var_sum    role       MEASURE
ds2@1.var_sum    type       INTEGER

# calc RHS is a written scalar expression -> its own node
e1.1             a          expression
e1.1             src        "var1 + var2"
e1.1             dependsOn  ds1@0.var1
e1.1             dependsOn  ds1@0.var2

# dependencies: var_sum from its defining expression; other columns pass through
ds2@1            dependsOn  ds1@0        op=calc
ds2@1.var_sum    dependsOn  e1.1         op=calc
ds2@1.id         dependsOn  ds1@0.id     op=calc
ds2@1.var1       dependsOn  ds1@0.var1   op=calc
ds2@1.var2       dependsOn  ds1@0.var2   op=calc
