digraph {
  // input binding: ds1
  "ds1@0"      [kind=dataset];
  "ds1@0.id"   [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=STRING];
  "ds1@0.var1" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];
  "ds1@0.var2" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];

  // stmt 1: ds2 := ds1[calc var_sum := var1 + var2]
  "ds2@1"          [kind=dataset, src="ds1[calc var_sum := var1 + var2]"];
  "ds2@1.id"       [kind=variable, dataset="ds2@1", role=IDENTIFIER, type=STRING];
  "ds2@1.var1"     [kind=variable, dataset="ds2@1", role=MEASURE, type=INTEGER];
  "ds2@1.var2"     [kind=variable, dataset="ds2@1", role=MEASURE, type=INTEGER];
  "ds2@1.var_sum"  [kind=variable, dataset="ds2@1", role=MEASURE, type=INTEGER];

  // calc RHS is a written scalar expression -> its own node
  "e1.1"           [kind=expression, src="var1 + var2"];
  "e1.1" -> "ds1@0.var1";
  "e1.1" -> "ds1@0.var2";

  // var_sum from its defining expression; other columns pass through
  "ds2@1"          -> "ds1@0"      [op=calc];
  "ds2@1.var_sum"  -> "e1.1"       [op=calc];
  "ds2@1.id"       -> "ds1@0.id"   [op=calc];
  "ds2@1.var1"     -> "ds1@0.var1" [op=calc];
  "ds2@1.var2"     -> "ds1@0.var2" [op=calc];
}
