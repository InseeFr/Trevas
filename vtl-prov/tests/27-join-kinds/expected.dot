digraph {
  // §5.27 — full_join (no using); same lineage shape as empty-body join.

  "ds1@0"    [kind=dataset];
  "ds1@0.id" [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=STRING];
  "ds1@0.m1" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];

  "ds2@0"    [kind=dataset];
  "ds2@0.id" [kind=variable, dataset="ds2@0", role=IDENTIFIER, type=STRING];
  "ds2@0.m2" [kind=variable, dataset="ds2@0", role=MEASURE, type=INTEGER];

  "ds_f@1"    [kind=dataset, src="full_join(ds1, ds2)"];
  "ds_f@1.id" [kind=variable, dataset="ds_f@1", role=IDENTIFIER, type=STRING];
  "ds_f@1.m1" [kind=variable, dataset="ds_f@1", role=MEASURE, type=INTEGER];
  "ds_f@1.m2" [kind=variable, dataset="ds_f@1", role=MEASURE, type=INTEGER];

  "ds_f@1"    -> "ds1@0"    [op=full_join];
  "ds_f@1"    -> "ds2@0"    [op=full_join];
  "ds_f@1.id" -> "ds1@0.id" [op=full_join];
  "ds_f@1.id" -> "ds2@0.id" [op=full_join];
  "ds_f@1.m1" -> "ds1@0.m1" [op=full_join];
  "ds_f@1.m2" -> "ds2@0.m2" [op=full_join];
}
