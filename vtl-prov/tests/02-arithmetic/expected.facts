# --- input binding: ds1
ds1@0            a          dataset
ds1@0.id         a          variable
ds1@0.id         dataset    ds1@0
ds1@0.id         role       IDENTIFIER
ds1@0.id         type       STRING
ds1@0.var1       a          variable
ds1@0.var1       dataset    ds1@0
ds1@0.var1       role       MEASURE
ds1@0.var1       type       INTEGER
ds1@0.var2       a          variable
ds1@0.var2       dataset    ds1@0
ds1@0.var2       role       MEASURE
ds1@0.var2       type       INTEGER

# --- input binding: ds2
ds2@0            a          dataset
ds2@0.id         a          variable
ds2@0.id         dataset    ds2@0
ds2@0.id         role       IDENTIFIER
ds2@0.id         type       STRING
ds2@0.var1       a          variable
ds2@0.var1       dataset    ds2@0
ds2@0.var1       role       MEASURE
ds2@0.var1       type       INTEGER
ds2@0.var2       a          variable
ds2@0.var2       dataset    ds2@0
ds2@0.var2       role       MEASURE
ds2@0.var2       type       INTEGER

# --- stmt 1: ds_sum := ds1 + ds2   (dataset-level op, no expression node)
ds_sum@1         a          dataset
ds_sum@1         src        "ds1 + ds2"
ds_sum@1.id      a          variable
ds_sum@1.id      dataset    ds_sum@1
ds_sum@1.id      role       IDENTIFIER
ds_sum@1.id      type       STRING
ds_sum@1.var1    a          variable
ds_sum@1.var1    dataset    ds_sum@1
ds_sum@1.var1    role       MEASURE
ds_sum@1.var1    type       INTEGER
ds_sum@1.var2    a          variable
ds_sum@1.var2    dataset    ds_sum@1
ds_sum@1.var2    role       MEASURE
ds_sum@1.var2    type       INTEGER

# dependencies: identifiers must match; each measure from both operands
ds_sum@1         dependsOn  ds1@0        op=+
ds_sum@1         dependsOn  ds2@0        op=+
ds_sum@1.id      dependsOn  ds1@0.id     op=+
ds_sum@1.id      dependsOn  ds2@0.id     op=+
ds_sum@1.var1    dependsOn  ds1@0.var1   op=+
ds_sum@1.var1    dependsOn  ds2@0.var1   op=+
ds_sum@1.var2    dependsOn  ds1@0.var2   op=+
ds_sum@1.var2    dependsOn  ds2@0.var2   op=+
