digraph {
  // Wave G PR-49 — membership # in join body (filter / calc / apply).
  // Qualifier ds#comp contributes the component name to expression refs.

  "ds1@0"    [kind=dataset];
  "ds1@0.id" [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=STRING];
  "ds1@0.m1" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];

  "ds2@0"    [kind=dataset];
  "ds2@0.id" [kind=variable, dataset="ds2@0", role=IDENTIFIER, type=STRING];
  "ds2@0.m2" [kind=variable, dataset="ds2@0", role=MEASURE, type=INTEGER];

  "#s1.1"    [kind=dataset, anon=true, src="inner_join(ds1, ds2 using id)"];
  "#s1.1.id" [kind=variable, dataset="#s1.1", role=IDENTIFIER, type=STRING];
  "#s1.1.m1" [kind=variable, dataset="#s1.1", role=MEASURE, type=INTEGER];
  "#s1.1.m2" [kind=variable, dataset="#s1.1", role=MEASURE, type=INTEGER];

  "#s1.1"    -> "ds1@0"    [op=inner_join];
  "#s1.1"    -> "ds2@0"    [op=inner_join];
  "#s1.1.id" -> "ds1@0.id" [op=inner_join];
  "#s1.1.id" -> "ds2@0.id" [op=inner_join];
  "#s1.1.m1" -> "ds1@0.m1" [op=inner_join];
  "#s1.1.m2" -> "ds2@0.m2" [op=inner_join];

  "e1.1" [kind=expression, src="ds1#m1 > 0"];
  "e1.1" -> "#s1.1.m1";

  "ds_f@1"    [kind=dataset, src="inner_join(ds1, ds2 using id filter ds1#m1 > 0)"];
  "ds_f@1.id" [kind=variable, dataset="ds_f@1", role=IDENTIFIER, type=STRING];
  "ds_f@1.m1" [kind=variable, dataset="ds_f@1", role=MEASURE, type=INTEGER];
  "ds_f@1.m2" [kind=variable, dataset="ds_f@1", role=MEASURE, type=INTEGER];

  "ds_f@1"    -> "#s1.1"    [op=filter];
  "ds_f@1"    -> "e1.1"     [op=filter, role=condition];
  "ds_f@1.id" -> "#s1.1.id" [op=filter];
  "ds_f@1.m1" -> "#s1.1.m1" [op=filter];
  "ds_f@1.m2" -> "#s1.1.m2" [op=filter];

  "#s2.1"    [kind=dataset, anon=true, src="inner_join(ds1, ds2 using id)"];
  "#s2.1.id" [kind=variable, dataset="#s2.1", role=IDENTIFIER, type=STRING];
  "#s2.1.m1" [kind=variable, dataset="#s2.1", role=MEASURE, type=INTEGER];
  "#s2.1.m2" [kind=variable, dataset="#s2.1", role=MEASURE, type=INTEGER];

  "#s2.1"    -> "ds1@0"    [op=inner_join];
  "#s2.1"    -> "ds2@0"    [op=inner_join];
  "#s2.1.id" -> "ds1@0.id" [op=inner_join];
  "#s2.1.id" -> "ds2@0.id" [op=inner_join];
  "#s2.1.m1" -> "ds1@0.m1" [op=inner_join];
  "#s2.1.m2" -> "ds2@0.m2" [op=inner_join];

  "e2.1" [kind=expression, src="ds1#m1 + ds2#m2"];
  "e2.1" -> "#s2.1.m1";
  "e2.1" -> "#s2.1.m2";

  "ds_c@2"    [kind=dataset, src="inner_join(ds1, ds2 using id calc x := ds1#m1 + ds2#m2)"];
  "ds_c@2.id" [kind=variable, dataset="ds_c@2", role=IDENTIFIER, type=STRING];
  "ds_c@2.m1" [kind=variable, dataset="ds_c@2", role=MEASURE, type=INTEGER];
  "ds_c@2.m2" [kind=variable, dataset="ds_c@2", role=MEASURE, type=INTEGER];
  "ds_c@2.x"  [kind=variable, dataset="ds_c@2", role=MEASURE, type=INTEGER];

  "ds_c@2"    -> "#s2.1"    [op=calc];
  "ds_c@2.id" -> "#s2.1.id" [op=calc];
  "ds_c@2.m1" -> "#s2.1.m1" [op=calc];
  "ds_c@2.m2" -> "#s2.1.m2" [op=calc];
  "ds_c@2.x"  -> "e2.1"     [op=calc];

  "#s3.1"    [kind=dataset, anon=true, src="inner_join(ds1, ds2 using id)"];
  "#s3.1.id" [kind=variable, dataset="#s3.1", role=IDENTIFIER, type=STRING];
  "#s3.1.m1" [kind=variable, dataset="#s3.1", role=MEASURE, type=INTEGER];
  "#s3.1.m2" [kind=variable, dataset="#s3.1", role=MEASURE, type=INTEGER];

  "#s3.1"    -> "ds1@0"    [op=inner_join];
  "#s3.1"    -> "ds2@0"    [op=inner_join];
  "#s3.1.id" -> "ds1@0.id" [op=inner_join];
  "#s3.1.id" -> "ds2@0.id" [op=inner_join];
  "#s3.1.m1" -> "ds1@0.m1" [op=inner_join];
  "#s3.1.m2" -> "ds2@0.m2" [op=inner_join];

  "e3.1" [kind=expression, src="ds1#m1 + ds2#m2"];
  "e3.1" -> "#s3.1.m1";
  "e3.1" -> "#s3.1.m2";

  "ds_a@3"         [kind=dataset, src="inner_join(ds1, ds2 using id apply ds1#m1 + ds2#m2)"];
  "ds_a@3.id"      [kind=variable, dataset="ds_a@3", role=IDENTIFIER, type=STRING];
  "ds_a@3.int_var" [kind=variable, dataset="ds_a@3", role=MEASURE, type=INTEGER];

  "ds_a@3"         -> "#s3.1"    [op=apply];
  "ds_a@3.id"      -> "#s3.1.id" [op=apply];
  "ds_a@3.int_var" -> "e3.1"     [op=apply];
}
