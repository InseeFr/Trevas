digraph {
  // §5.34 — exists_in: boolean measure; right dataset is condition.

  "ds1@0"    [kind=dataset];
  "ds1@0.id" [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=STRING];
  "ds1@0.m1" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];

  "ds2@0"    [kind=dataset];
  "ds2@0.id" [kind=variable, dataset="ds2@0", role=IDENTIFIER, type=STRING];
  "ds2@0.m2" [kind=variable, dataset="ds2@0", role=MEASURE, type=INTEGER];

  "ds3@1"          [kind=dataset, src="exists_in(ds1, ds2)"];
  "ds3@1.id"       [kind=variable, dataset="ds3@1", role=IDENTIFIER, type=STRING];
  "ds3@1.bool_var" [kind=variable, dataset="ds3@1", role=MEASURE, type=BOOLEAN];

  "ds3@1"          -> "ds1@0"    [op=exists_in];
  "ds3@1"          -> "ds2@0"    [op=exists_in, role=condition];
  "ds3@1.id"       -> "ds1@0.id" [op=exists_in];
  "ds3@1.bool_var" -> "ds1@0.id" [op=exists_in];
  "ds3@1.bool_var" -> "ds2@0.id" [op=exists_in, role=condition];
}
