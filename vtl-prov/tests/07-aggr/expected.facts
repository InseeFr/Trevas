# --- input binding: ds1
ds1@0            a          dataset
ds1@0.id         a          variable
ds1@0.id         dataset    ds1@0
ds1@0.id         role       IDENTIFIER
ds1@0.id         type       STRING
ds1@0.var1       a          variable
ds1@0.var1       dataset    ds1@0
ds1@0.var1       role       MEASURE
ds1@0.var1       type       INTEGER
ds1@0.var2       a          variable
ds1@0.var2       dataset    ds1@0
ds1@0.var2       role       MEASURE
ds1@0.var2       type       INTEGER

# --- stmt 1: ds2 := ds1[aggr total := sum(var1) group by id]
# var2 is neither grouped nor aggregated -> dropped from the result
ds2@1            a          dataset
ds2@1            src        "ds1[aggr total := sum(var1) group by id]"
ds2@1.id         a          variable
ds2@1.id         dataset    ds2@1
ds2@1.id         role       IDENTIFIER
ds2@1.id         type       STRING
ds2@1.total      a          variable
ds2@1.total      dataset    ds2@1
ds2@1.total      role       MEASURE
ds2@1.total      type       INTEGER

# aggregation function is a written expression -> its own node
e1.1             a          expression
e1.1             src        "sum(var1)"
e1.1             dependsOn  ds1@0.var1

# dependencies: group-by key passes through (value input); total from sum(var1)
ds2@1            dependsOn  ds1@0        op=aggr
ds2@1.id         dependsOn  ds1@0.id     op=aggr
ds2@1.total      dependsOn  e1.1         op=aggr
