# --- input binding: ds1
ds1@0            a          dataset
ds1@0.id         a          variable
ds1@0.id         dataset    ds1@0
ds1@0.id         role       IDENTIFIER
ds1@0.id         type       STRING
ds1@0.var1       a          variable
ds1@0.var1       dataset    ds1@0
ds1@0.var1       role       MEASURE
ds1@0.var1       type       INTEGER
ds1@0.var2       a          variable
ds1@0.var2       dataset    ds1@0
ds1@0.var2       role       MEASURE
ds1@0.var2       type       INTEGER

# --- stmt 1: ds2 := ds1[filter mod(var1, 2) = 0]   (structure unchanged)
ds2@1            a          dataset
ds2@1            src        "ds1[filter mod(var1, 2) = 0]"
ds2@1.id         a          variable
ds2@1.id         dataset    ds2@1
ds2@1.id         role       IDENTIFIER
ds2@1.id         type       STRING
ds2@1.var1       a          variable
ds2@1.var1       dataset    ds2@1
ds2@1.var1       role       MEASURE
ds2@1.var1       type       INTEGER
ds2@1.var2       a          variable
ds2@1.var2       dataset    ds2@1
ds2@1.var2       role       MEASURE
ds2@1.var2       type       INTEGER

# filter predicate is a written expression -> its own node
e1.1             a          expression
e1.1             src        "mod(var1, 2) = 0"
e1.1             dependsOn  ds1@0.var1

# dependencies: dataset from input (data) + predicate (condition); columns pass through
ds2@1            dependsOn  ds1@0        op=filter
ds2@1            dependsOn  e1.1         op=filter  role=condition
ds2@1.id         dependsOn  ds1@0.id     op=filter
ds2@1.var1       dependsOn  ds1@0.var1   op=filter
ds2@1.var2       dependsOn  ds1@0.var2   op=filter
