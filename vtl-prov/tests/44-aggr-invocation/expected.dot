digraph {
  // Aggregate invocation producers: sum/count(DS group by …).

  "ds1@0"    [kind=dataset];
  "ds1@0.id" [kind=variable, dataset="ds1@0", role=IDENTIFIER, type=STRING];
  "ds1@0.m1" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];
  "ds1@0.m2" [kind=variable, dataset="ds1@0", role=MEASURE, type=INTEGER];

  "e1.1" [kind=expression, src="sum(ds1 group by id)"];
  "e1.2" [kind=expression, src="sum(ds1 group by id)"];
  "ds2@1"    [kind=dataset, src="sum(ds1 group by id)"];
  "ds2@1.id" [kind=variable, dataset="ds2@1", role=IDENTIFIER, type=STRING];
  "ds2@1.m1" [kind=variable, dataset="ds2@1", role=MEASURE, type=NUMBER];
  "ds2@1.m2" [kind=variable, dataset="ds2@1", role=MEASURE, type=NUMBER];

  "e2.1" [kind=expression, src="count(ds1 group by id)"];
  "ds3@2"         [kind=dataset, src="count(ds1 group by id)"];
  "ds3@2.id"      [kind=variable, dataset="ds3@2", role=IDENTIFIER, type=STRING];
  "ds3@2.int_var" [kind=variable, dataset="ds3@2", role=MEASURE, type=INTEGER];

  "e1.1" -> "ds1@0.m1";
  "e1.2" -> "ds1@0.m2";
  "ds2@1"    -> "ds1@0"    [op=aggr];
  "ds2@1.id" -> "ds1@0.id" [op=aggr];
  "ds2@1.m1" -> "e1.1"     [op=aggr];
  "ds2@1.m2" -> "e1.2"     [op=aggr];

  "ds3@2"         -> "ds1@0"    [op=aggr];
  "ds3@2.id"      -> "ds1@0.id" [op=aggr];
  "ds3@2.int_var" -> "e2.1"     [op=aggr];
}
